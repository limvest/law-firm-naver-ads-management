    "agent:discover-sources": "tsx scripts/agent/discover-naver-sources.ts",
    "agent:discover-cycle": "zsh scripts/agent/discovery-supervisor.sh",
    "agent:discover-public": "tsx scripts/agent/run-naver-public-discovery.ts",
    "agent:source-family": "tsx scripts/agent/reconcile-source-families.ts",
    "agent:parser": "tsx scripts/agent/analyze-pending-sources.ts",
    "agent:review": "tsx scripts/agent/review-operational-db.ts --force",
    "workers:collection": "tsx scripts/agent/run-collection-workers.ts",
    "workers:click": "node --import tsx scripts/agent/run-click-collection.ts",
