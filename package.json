{
  "name": "lawfirm-ads",
  "private": true,
  "scripts": {
    "theme:sampleone-fintech": "node scripts/build-sampleone-fintech-mirror.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages:refresh": "tsx scripts/agent/generate-scam-pages.ts",
