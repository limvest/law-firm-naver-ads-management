<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lawfirm-ads.click-collection</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/opt/lawfirm-ads/scripts/agent/click-collection-daemon.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/lawfirm-ads</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/private/tmp/lawfirm-click-collection.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/lawfirm-click-collection.log</string>
</dict>
</plist>
