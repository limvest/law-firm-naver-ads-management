<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lawfirm-ads.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/opt/lawfirm-ads/scripts/agent/daily-supervisor.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/lawfirm-ads</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>47</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/opt/lawfirm-ads/data/keyword-inbox/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/lawfirm-ads/data/keyword-inbox/agent.log</string>
</dict>
</plist>
