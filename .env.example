DATABASE_URL=
ADMIN_TOKEN=            # /operator 총운영자 콘솔 접근 토큰
CRED_ENC_KEY=           # openssl rand -base64 32 (네이버 광고 자격증명 암호화)
OPENAI_AGENT_MODEL=gpt-5.6-sol  # 데일리 LLM 추출 모델 (codex login 인증 필요)
NAVER_PUBLIC_SEARCH_ENABLED=0  # 기본 중지. 1일 때만 공개 네이버 통합검색 HTML 조회
NAVER_PUBLIC_SEARCH_CONCURRENCY=1 # 동시 요청 1, 최대 2
NAVER_PUBLIC_SEARCH_INTERVAL_MS=3000 # 검색 요청 최소 간격
NAVER_DISCOVERY_LEDGER_WRITE=0 # 1 + --persist-ledger일 때만 후보 원장 DB 저장(키워드 발행 없음)
NAVER_SOURCE_DISCOVERY_BATCH=100       # 하루에 검색할 기존 사건명 수(최대 500)
NAVER_SOURCE_DISCOVERY_MIN_SEEDS=2     # 서로 다른 사건명에서 반복 노출돼야 소스 후보 등록
SOURCE_DISCOVERY_EXCLUDED_HOSTS=       # 추가 제외 도메인, 쉼표 구분
AGENT_AUTO_DEPLOY=0     # 기본 0. 1이어도 깨끗한 작업트리에서만 Vercel 코드 배포
LEAD_ENC_KEY=            # openssl rand -base64 32
LEAD_ROUTING_SECRET=     # 선택: 공용 preview의 firm별 상담 라우팅 서명키 (미설정 시 LEAD_ENC_KEY 사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIGEST_SECRET=       # 내부 09:00·18:00 보고 API 인증값
TELEGRAM_FIRM_SLUG=sampleone
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_NAVER_WCS_ID=
NEXT_PUBLIC_SITE_URL=   # 제품 정본 URL. 고객 canonical은 firms.domain을 사용
SEARCH_PERFORMANCE_SNAPSHOT_PATH= # 선택: Naver Search Advisor/GSC 정형 JSON snapshot. 미설정 시 일일 동기화 skip
NAVER_AD_PERFORMANCE_DAY= # 선택: 광고 통계 동기화 일자(YYYY-MM-DD). 기본은 서울 기준 전일
ENGINE_LIVE=0             # 전역 외부 변경 허용. 1만으로는 target 광고가 실행되지 않음
TARGET_AD_AUTOMATION=0    # 기본 0. ENGINE_LIVE=1과 함께 설정해야 고객 승인 범위의 target 광고 등록 실행
# 사건명 서브도메인(서버 전용, 운영 비밀키는 별도 secret store에 저장)
KEYWORD_HOST_SIGNING_KEY=
KEYWORD_SUBDOMAIN_MODE=off
