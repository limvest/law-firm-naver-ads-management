# Secrets are installed separately at /etc/lawfirm-ads/agent.env (mode 0600).
# A1 Docker uses the private service hostname; PostgreSQL port 5432 is not
# published on the host or internet.
DATABASE_URL=postgresql://lawfirm_ads:CHANGE_ME@postgres:5432/lawfirm_ads
DATABASE_URL_UNPOOLED=postgresql://lawfirm_ads:CHANGE_ME@postgres:5432/lawfirm_ads
DATABASE_POOL_MAX=2
CRED_ENC_KEY=
LEAD_ENC_KEY=
LEAD_ROUTING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIGEST_SECRET=
TELEGRAM_FIRM_SLUG=sampleone
NEXT_PUBLIC_SITE_URL=https://sampleone.attorney
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_NAVER_WCS_ID=
KEYWORD_HOST_SIGNING_KEY=
KEYWORD_SUBDOMAIN_MODE=on
# 광고 외부 변경은 명령 실행 시에만 일시적으로 1을 주입한다. 상시 활성화하지 않는다.
ENGINE_LIVE=0
TARGET_AD_AUTOMATION=0
