[Unit]
Description=Sweep current-day Naver keyword exposure after ad hours
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lawfirm-ads/current
ExecStart=/usr/bin/docker compose -f deploy/a1/docker-compose.yml --profile scheduled run --rm daily ./node_modules/.bin/tsx scripts/engine/sync-keyword-search-stats.ts --firm 289283342 --day today
TimeoutStartSec=2h
